{
  "name": "Hugo site",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/hugo:1": {
      "version": "0.168.0",
      "extended": true
    }
  },
  "postCreateCommand": "git submodule update --init --recursive",
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo preview",
      "onAutoForward": "notify"
    }
  }
}
